# ── الخادم ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# أصل الواجهة المسموح له باستخدام ملف تعريف الجلسة (مفصول بفواصل عند الحاجة)
# مجلد بناء الواجهة لخدمتها من نفس المنفذ (فارغ = اكتشاف تلقائي لـ apps/web/dist)
WEB_DIST_DIR=
APP_ORIGIN=http://localhost:5173

# ── قاعدة البيانات PostgreSQL ───────────────────────────
DATABASE_URL=postgres://tg_user:CHANGE_ME@127.0.0.1:5432/telegram_monitor
# الحد الأعلى لحجم مجمع الاتصالات
DB_POOL_MAX=10
# مهلة الاتصال بالمللي ثانية
DB_CONNECT_TIMEOUT_MS=5000

# ── سياسات الجلسات والأمان (قابلة للتعديل التشغيلي) ────
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=720
SESSION_COOKIE_NAME=tg_sid
COOKIE_SECURE=auto
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# في التطوير فقط: إظهار رمز الاستعادة في الاستجابة لاختبار المسار (يُرفض في الإنتاج)
DEV_EXPOSE_RESET_TOKEN=true
# بريد اختياري لترقية أول مستخدم مسجّل إلى مدير النظام (فارغ = معطّل)
BOOTSTRAP_ADMIN_EMAIL=

# ── السجلات ────────────────────────────────────────────
LOG_LEVEL=info

# ── Telegram MTProto (المرحلة الثانية) ─────────────────
# بيانات تطبيق من https://my.telegram.org — تُترك فارغة حتى توفير اعتماد مصرّح به.
TG_API_ID=
TG_API_HASH=
# مفتاح تشفير جلسات MTProto: 32 بايت base64 (AES-256-GCM). إلزامي لأي اتصال حقيقي.
# توليده: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TG_SESSION_ENC_KEY=
TG_SESSION_ENC_KEY_VERSION=1
# مفتاح سابق مقبول للفك فقط أثناء تدوير المفاتيح (يتطلب رفع النسخة فوق 1).
TG_SESSION_ENC_KEY_PREVIOUS=
# عدد محاولات الاتصال ومحاولات إعادة الاتصال القصوى (لا حلقات غير محدودة)
TG_CONNECTION_RETRIES=3
TG_MAX_RECONNECT_ATTEMPTS=5
TG_RECONNECT_BASE_DELAY_MS=1000
# انتظار FloodWait تلقائياً حتى هذا الحد بالثواني؛ 0 = إظهار الخطأ دون انتظار
TG_FLOOD_SLEEP_THRESHOLD=0
# استلام ما فات من تحديثات بعد إعادة التشغيل (تُعلَّم missed)
TG_CATCH_UP=true
# استخدام خوادم تيليجرام التجريبية (لا تخلط جلسات الإنتاج بالاختبار)
TG_TEST_SERVERS=false
TG_REQUEST_TIMEOUT_SECONDS=20
# ── حالة الربط المؤقتة (المرحلة الثانية/الخطوة 2) ──────────────
# صلاحية محاولة الربط بالدقائق (رمز الدخول أو كلمة التحقق بخطوتين).
TG_LOGIN_TTL_MINUTES=10
# حدود المحاولات: رمز خاطئ، كلمة مرور خاطئة، وعدد مرات إعادة إرسال الرمز.
TG_LOGIN_MAX_CODE_ATTEMPTS=5
TG_LOGIN_MAX_PASSWORD_ATTEMPTS=3
TG_LOGIN_MAX_RESENDS=3
TG_LOGIN_RESEND_INTERVAL_SECONDS=30
# إعادة توصيل الحسابات النشطة عند بدء الخادم (D03/O01).
TG_RESTORE_ON_START=true
# الحد الأقصى لعدد المصادر لكل حساب تيليجرام (D11/O08: ملف إطلاق 25 مصدراً لكل حساب).
TG_MAX_SOURCES_PER_ACCOUNT=25
# ── النشر (المرحلة الثالثة — 7-أ/7-ب) ───────────────────
# مفتاح مستقل لتشفير رموز بوتات النشر (32 بايت base64)، لا يُعاد استخدام مفتاح الجلسات (Q1).
# توليده: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# بدونه يبقى النشر «غير مهيأ»: تُرفض عمليات ربط البوت بـ503 دون أي طلب خارجي.
TG_BOT_ENC_KEY=
TG_BOT_ENC_KEY_VERSION=1
# مفتاح سابق للفك فقط أثناء تدوير المفاتيح (يتطلب رفع النسخة فوق 1).
TG_BOT_ENC_KEY_PREVIOUS=
# أصل Bot API ومهلة الطلب بالمللي ثانية (يُستبدل بعميل مزيّف في الاختبارات فقط).
TG_BOT_API_BASE_URL=https://api.telegram.org
TG_BOT_API_TIMEOUT_MS=10000
# محرك التوجيه: إنشاء تسليمات النشر عند اكتمال المعالجة.
TG_ROUTING_ENABLED=true
# سقوف إعدادات النشر لكل مستخدم.
TG_MAX_DESTINATIONS_PER_USER=20
TG_MAX_ROUTES_PER_USER=50
# عامل الإرسال (7-د): داخل العملية بتزامن ≤3 وفاصل 1.2 ثانية لكل محادثة.
TG_PUBLISH_WORKER_ENABLED=true
TG_PUBLISH_WORKER_INTERVAL_MS=3000
TG_PUBLISH_LEASE_SECONDS=90
# عتبة اعتبار عامل النشر متوقفاً (P4-ب، Q26).
TG_OPS_WORKER_STALE_SECONDS=120
# دورية مشغّل الاحتفاظ الوحيد داخل العملية بالدقائق (P4-د، Q23). الافتراضي ساعة.
TG_RETENTION_INTERVAL_MINUTES=60
# الخطوة الرابعة: محرّك الالتقاط (لا يخزّن نصاً ولا وسائط).
TG_INGEST_ENABLED=true
# مدة الاحتفاظ بهويات الرسائل لمنع التكرار (بعدها لا يُضمن منع التكرار).
TG_INGEST_IDENTITY_RETENTION_DAYS=30
TG_INGEST_MAX_ATTEMPTS=3
TG_INGEST_PURGE_INTERVAL_MINUTES=360
# مسار ملف سجل اختياري (الافتراضي: المخرج القياسي).
LOG_FILE=

# ─── البريد الصادر (P0 — تدقيق ما قبل التسليم) ───────────────────────────────
# الرابط العام الذي يفتحه المستخدم فعلاً. تُبنى منه روابط رسائل البريد
# (استعادة كلمة المرور). بدونه ستُبنى على localhost ولن تعمل من جهاز المستخدم.
APP_PUBLIC_URL=https://app.example.com

# أفرغ SMTP_HOST لتعطيل البريد: تبقى الرسائل pending ولا تُحرق محاولات، ولا أعطال إقلاع.
# للتفعيل: عيّن HOST وFROM معاً. المصادقة (USER/PASS) لا تُرسل إلا عبر TLS:
#   587 ⇒ SMTP_SECURE=false (STARTTLS) · 465 ⇒ SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=منصة الرصد والنشر
SMTP_TIMEOUT_MS=15000
# شهادة CA داخلية (مسار ملف PEM) — اتركه فارغاً للشهادات العامة. لا يوجد خيار لتعطيل التحقق.
SMTP_CA_PATH=

# مستهلك صندوق البريد: كل 30 ثانية رسالة واحدة على الأكثر. 0 = تعطيل صريح (صيانة فقط).
OUTBOX_INTERVAL_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
