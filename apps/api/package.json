{
  "name": "@tg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "create-admin": "tsx src/db/create-admin.ts",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "telegram:smoke": "tsx src/cli/telegramSmoke.ts"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "teleproto": "1.234.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.6.0-beta.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
