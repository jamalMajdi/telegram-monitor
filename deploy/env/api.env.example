# ═══════════════════════════════════════════════════════════════════════
#  بيئة الإنتاج — TG Monitor (P4-ز)
#  الموقع النهائي: /etc/tg-monitor/api.env    (root:tgmon، صلاحية 640)
#  لا تُضع هذا الملف في المستودع بقيم حقيقية. كل قيمة هنا افتراضية،
#  وما هو «إلزامي» أو «يجب تغييره» معلَّم صريحاً.
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ——— الاستماع: خلف nginx فقط (لا تُعرّض المنفذ للإنترنت) ———
API_HOST=127.0.0.1
API_PORT=4000
# أصل الواجهة الكامل بـhttps. خطؤه يمنع CSRF ويعطّل الدخول.
APP_ORIGIN=https://monitor.example.com
# الكوكي لا يُرسل إلّا عبر HTTPS: في الإنتاج true صريحة.
COOKIE_SECURE=true

# ——— قاعدة البيانات (إلزامي) ———
# أنشئ دوراً مخصّصاً لا superuser (runbook §3)، وكلمة مروره من generate-secrets.sh
DATABASE_URL=postgres://tgmon:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/tg_monitor
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# ——— الجلسات ———
SESSION_COOKIE_NAME=tg_sid
# lax (افتراضي، الأكثر أماناً — الواجهة والـAPI على أصل واحد) | none (فقط داخل إطار من أصل مختلف)
# عند none يُفرض Secure تلقائياً ويُرفض مع COOKIE_SECURE=false.
SESSION_COOKIE_SAMESITE=lax
# مسار معاينة فقط: يُصدر رمز الجلسة في جسم الدخول لتجاوز حجب الكوكيز داخل الإطارات.
# ممنوع في الإنتاج (يرفض الخادم الإقلاع إذا كان true مع NODE_ENV=production).
AUTH_BEARER_FALLBACK=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=720

# ——— تحديد المعدل وقفل الدخول ———
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_RESET_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# يجب أن يبقى false في الإنتاج (التحقق يرفض التشغيل لو كان true).
DEV_EXPOSE_RESET_TOKEN=false
# أول مدير: يُرقَّى تلقائياً عند التسجيل بهذا البريد. اتركه فارغاً بعد إنشاء المدير.
BOOTSTRAP_ADMIN_EMAIL=

# ——— تيليجرام (MTProto) ———
# من my.telegram.org (API development tools). كلاهما أو لا شيء.
TG_API_ID=
TG_API_HASH=
# إلزامي للاتصال الحقيقي — من generate-secrets.sh (32 بايت base64).
TG_SESSION_ENC_KEY=
TG_SESSION_ENC_KEY_VERSION=1
# للتدوير فقط: يُقرأ بالفك ويُعاد التشفير بالمفتاح الجديد (runbook §8).
# TG_SESSION_ENC_KEY_PREVIOUS=
TG_RESTORE_ON_START=true
TG_CONNECTION_RETRIES=3
TG_MAX_RECONNECT_ATTEMPTS=5
TG_RECONNECT_BASE_DELAY_MS=1000
TG_REQUEST_TIMEOUT_SECONDS=20
TG_CATCH_UP=true
TG_FLOOD_SLEEP_THRESHOLD=0
TG_TEST_SERVERS=false

# ——— حدود الالتقاط والمعالجة ———
TG_MAX_SOURCES_PER_ACCOUNT=25
TG_INGEST_ENABLED=true
TG_INGEST_IDENTITY_RETENTION_DAYS=30
TG_INGEST_MAX_ATTEMPTS=3
TG_INGEST_PURGE_INTERVAL_MINUTES=360
TG_PROCESSING_ENABLED=true
TG_EXTRACTION_ENABLED=true
TG_CONTENT_PURGE_INTERVAL_MINUTES=60

# ——— النشر ———
# إلزامي للنشر — مستقل عن مفتاح الجلسات (Q1).
TG_BOT_ENC_KEY=
TG_BOT_ENC_KEY_VERSION=1
# TG_BOT_ENC_KEY_PREVIOUS=
TG_BOT_API_BASE_URL=https://api.telegram.org
TG_BOT_API_TIMEOUT_MS=10000
TG_ROUTING_ENABLED=true
TG_MAX_DESTINATIONS_PER_USER=20
TG_MAX_ROUTES_PER_USER=50
TG_PUBLISH_WORKER_ENABLED=true
TG_PUBLISH_WORKER_INTERVAL_MS=3000
# عتبة «العامل متوقف» (Q26) — بنية تحتية، تبقى في البيئة لا في القاعدة.
TG_OPS_WORKER_STALE_SECONDS=120
TG_PUBLISH_LEASE_SECONDS=90
TG_RETENTION_INTERVAL_MINUTES=60

# ——— السجلات ———
# اتركها info في الإنتاج. لا تُفعّل debug بلا سبب: يزيد الحجم بلا فائدة.
LOG_LEVEL=info
# اتركه فارغاً: journald يتولّى التخزين والتدوير.
LOG_FILE=
